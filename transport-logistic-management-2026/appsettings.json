{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "ObservabilitySettings": {
    "ServiceName": "fleet-management-api",
    "OtlpEndpoint": ""
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "connectionString": "Server=(localdb)\\mssqllocaldb;Database=TransportLogisticsDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "JwtSettings": {
    "Issuer": "http://localhost:5126",
    "Audience": "http://localhost:3000",
    "AccessTokenExpiryInMinutes": 15
  },
  "RefreshTokenSettings": {
    "ExpiryInDays": 7,
    "RotatedTokenReuseGracePeriodInSeconds": 30
  },
  "RateLimitingSettings": {
    "CredentialEndpointsPermitLimitPerIpAddress": 10,
    "CredentialEndpointsWindowInSeconds": 60,
    "GeneralPermitLimitPerUser": 300,
    "GeneralWindowInSeconds": 60
  },
  "AuditLogRetentionSettings": {
    "RetentionPeriodInDays": 365
  },
  "CityGeocodingSettings": {
    "BaseUrl": "https://geocoding-api.open-meteo.com/v1/",
    "StoredNamesLanguageCode": "en",
    "RequestTimeoutInSeconds": 10
  },
  "ExternalIdentitySettings": {
    "Authority": "",
    "ClientId": "",
    "GroupRoleMappings": {}
  },
  "ForwardedHeadersSettings": {
    "KnownProxyAddresses": []
  }
}
