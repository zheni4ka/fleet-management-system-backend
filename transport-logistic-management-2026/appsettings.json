{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "connectionString": "Server=(localdb)\\mssqllocaldb;Database=TransportLogisticsDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "JwtSettings": {
    "Issuer": "http://localhost:5126",
    "Audience": "http://localhost:3000",
    "AccessTokenExpiryInMinutes": 15
  },
  "RefreshTokenSettings": {
    "ExpiryInDays": 7,
    "RotatedTokenReuseGracePeriodInSeconds": 30
  },
  "RateLimitingSettings": {
    "CredentialEndpointsPermitLimitPerIpAddress": 10,
    "CredentialEndpointsWindowInSeconds": 60,
    "GeneralPermitLimitPerUser": 300,
    "GeneralWindowInSeconds": 60
  },
  "ForwardedHeadersSettings": {
    "KnownProxyAddresses": []
  }
}
